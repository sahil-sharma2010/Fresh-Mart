# FreshMart Backend Environment Configuration (.env.example)
# Copy this file to .env and fill in your real credentials before starting the backend server.
# NEVER commit real API keys, passwords, or Supabase service_role keys to public repositories.

PORT=5000
JWT_SECRET=replace_with_a_strong_random_64_char_secret

# EmailJS or Transactional Email Configuration for real OTP delivery
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Optional Supabase Configuration (Public Anon Key only on frontend; use RLS)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_public_anon_key
